{
  "name": "@sea-rescue-fremantle/design-system",
  "version": "1.0.0",
  "description": "Rescue MD3 — the Sea Rescue Fremantle design system. Material Design 3 structure, brand-led skin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sea-Rescue-Fremantle/design-system.git"
  },
  "homepage": "https://sea-rescue-fremantle.github.io/design-system/",
  "bugs": "https://github.com/Sea-Rescue-Fremantle/design-system/issues",
  "keywords": ["design-system", "design-tokens", "dtcg", "material-design", "mui", "marine-rescue"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "default": "./dist/layouts/index.js"
    },
    "./tokens.css": "./build/tokens.css",
    "./tokens.dtcg.json": "./tokens.dtcg.json",
    "./manifest.webmanifest": "./assets/pwa/manifest.webmanifest",
    "./assets/*": "./assets/*"
  },
  "files": ["dist", "build", "assets/pwa", "assets/brand", "tokens.dtcg.json", "AGENTS.md", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "npm run tokens && git diff --exit-code build/",
    "build": "npm run tokens && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run tokens:check && npm run typecheck && npm run lint && npm run lint:css",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "react": "^18.3.1 || ^19.1.0",
    "react-dom": "^18.3.1 || ^19.1.0"
  },
  "peerDependenciesMeta": {
    "react-dom": { "optional": false }
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@mui/icons-material": "7.1.1",
    "@mui/material": "7.1.1",
    "@types/react": "19.1.8",
    "eslint": "9.28.0",
    "eslint-plugin-react": "7.37.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stylelint": "16.20.0",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0"
  },
  "engines": { "node": ">=20.11 <23", "npm": ">=10.5" }
}
